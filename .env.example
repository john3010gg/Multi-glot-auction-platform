# Copiar a .env (`cp .env.example .env`). docker compose lo lee automáticamente.
# Todo lo de este archivo son PLACEHOLDERS: el andamiaje solo propaga las
# variables; ningún servicio las aplica todavía. Ver la tabla del README.

# ── Interruptor de modo ──────────────────────────────────────
# false = modo vulnerable (todas las defensas apagadas)
# true  = modo blindado   (todas las defensas encendidas)
HARDENED=false

# ── Puertos ──────────────────────────────────────────────────
# GRAPHQL_PORT es el único puerto publicado al host; los otros dos solo
# existen dentro de la red backend.
GRAPHQL_PORT=4000
SUBASTAS_GRPC_PORT=50051
USUARIOS_HTTP_PORT=8080

# ── Servicio usuarios parametrizable ─────────────────────────
# Cambiar el Dockerfile permite sustituir la implementación (Haskell/Servant)
# por otra que respete el contrato REST de services/usuarios/README.md.
# USUARIOS_CABAL_FLAGS="-f proto" compila además los tipos generados del .proto.
USUARIOS_DOCKERFILE=services/usuarios/Dockerfile
USUARIOS_CABAL_FLAGS=

# ── TLS (solo HARDENED=true) ─────────────────────────────────
# TODO(equipo): generar los certificados en ./certs (ver `make certs`).
TLS_CA_FILE=/certs/ca.pem
TLS_CERT_FILE=/certs/servicio.pem
TLS_KEY_FILE=/certs/servicio-key.pem

# ── Autenticación / autorización (solo HARDENED=true) ────────
# TODO(equipo): definir el esquema real (JWT, mTLS, ...) y sus secretos.
AUTH_SECRET=CAMBIAR
SECRET_KEY_BASE=CAMBIAR_por_un_valor_aleatorio_de_al_menos_64_caracteres_0123456789abcdef

# ── Límites GraphQL (solo HARDENED=true) ─────────────────────
# TODO(equipo): justificar estos valores en el informe (API4).
GRAPHQL_MAX_DEPTH=0
GRAPHQL_MAX_COMPLEXITY=0

# ── Rate limiting (solo HARDENED=true) ───────────────────────
# TODO(equipo): justificar estos valores en el informe (API4/API6).
RATE_LIMIT_MAX=0
RATE_LIMIT_WINDOW_MS=0
